<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The UI-framework-free brain shared by BOTH front-ends: the WinUI 3 app
    (Windows) and the Avalonia app (the Linux backup). Everything that is not an
    actual XAML view lives here — protocol client, DTOs and MVVM view-models — so
    the two GUIs are thin and the framework is swappable (docs/gui-plan.md §4).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source-generated [ObservableProperty]/[RelayCommand]; works in WinUI and Avalonia. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
