<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ObotControl.Core.ViewModels;assembly=ObotControl.Core"
             xmlns:core="clr-namespace:ObotControl.Core;assembly=ObotControl.Core"
             x:Class="ObotControl.App.Views.ConfigurationView"
             x:DataType="vm:ConfigurationViewModel" x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Margin="10" Spacing="14" MaxWidth="860" HorizontalAlignment="Left">

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding Connected}"
                ToolTip.Tip="{x:Static core:HelpText.Save}"/>
        <Button Content="Revert" Command="{Binding RevertCommand}"
                ToolTip.Tip="Discard edits and return to the last-saved values."/>
        <Button Content="Reload" Command="{Binding ReloadCommand}" IsEnabled="{Binding Connected}"
                ToolTip.Tip="{x:Static core:HelpText.Reload}"/>
        <TextBlock Text="● unsaved" Foreground="#E0A040" VerticalAlignment="Center" IsVisible="{Binding IsDirty}"
                   ToolTip.Tip="{x:Static core:HelpText.DirtyFlag}"/>
        <TextBlock Text="{Binding Status}" Foreground="#9FB2C8" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Speech / TTS -->
      <Border Background="#141A22" CornerRadius="8" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="Speech" FontWeight="Bold" FontSize="15"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Engine chain" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding TtsEngines}" SelectedItem="{Binding TtsEngine}" Width="120"
                      ToolTip.Tip="{x:Static core:HelpText.TtsEngine}"/>
            <TextBlock Text="Piper pace" VerticalAlignment="Center"/>
            <Slider Minimum="0.6" Maximum="1.4" Value="{Binding PiperLengthScale}" Width="140"/>
            <TextBlock Text="Local wpm" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding LocalRateWpm}" Minimum="80" Maximum="320" Increment="5" Width="120"/>
          </StackPanel>
          <TextBox Text="{Binding GeminiStyle}" Watermark="Gemini style directive (e.g. 'Say cheerfully:')"/>
        </StackPanel>
      </Border>

      <!-- Mouth tuning (live) -->
      <Border Background="#141A22" CornerRadius="8" Padding="12" ToolTip.Tip="{x:Static core:HelpText.MouthTuning}">
        <StackPanel Spacing="4">
          <TextBlock Text="Mouth tuning (applies live while talking)" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
          <Grid ColumnDefinitions="150,*,60" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="fps"/>
            <Slider Grid.Row="0" Grid.Column="1" Minimum="10" Maximum="60" Value="{Binding Fps}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Fps, StringFormat='0'}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="gate"/>
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="0.3" Value="{Binding Gate}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Gate, StringFormat='0.00'}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="gamma"/>
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0.2" Maximum="1.5" Value="{Binding Gamma}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Gamma, StringFormat='0.00'}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="attack"/>
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Attack}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Attack, StringFormat='0.00'}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="release"/>
            <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Release}"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Release, StringFormat='0.00'}"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="top gain"/>
            <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding TopGain}"/>
            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding TopGain, StringFormat='0.0'}"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="bottom gain"/>
            <Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding BottomGain}"/>
            <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding BottomGain, StringFormat='0.0'}"/>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="top max"/>
            <Slider Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding TopMaxDelta}"/>
            <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding TopMaxDelta, StringFormat='0.0'}"/>
            <TextBlock Grid.Row="8" Grid.Column="0" Text="bottom max"/>
            <Slider Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding BottomMaxDelta}"/>
            <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding BottomMaxDelta, StringFormat='0.0'}"/>
            <TextBlock Grid.Row="9" Grid.Column="0" Text="sync offset (s)"/>
            <Slider Grid.Row="9" Grid.Column="1" Minimum="-0.3" Maximum="0.3" Value="{Binding SyncOffset}"/>
            <TextBlock Grid.Row="9" Grid.Column="2" Text="{Binding SyncOffset, StringFormat='0.00'}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Motion -->
      <Border Background="#141A22" CornerRadius="8" Padding="12" ToolTip.Tip="{x:Static core:HelpText.Motion}">
        <StackPanel Spacing="4">
          <TextBlock Text="Motion" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
          <Grid ColumnDefinitions="150,*,60" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="tick (s)"/>
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0.02" Maximum="0.2" Value="{Binding TickS}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TickS, StringFormat='0.00'}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="head rate"/>
            <Slider Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="80" Value="{Binding RateLimit}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RateLimit, StringFormat='0'}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="lip rate"/>
            <Slider Grid.Row="2" Grid.Column="1" Minimum="50" Maximum="400" Value="{Binding LipRateLimit}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LipRateLimit, StringFormat='0'}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="write epsilon"/>
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0.01" Maximum="0.3" Value="{Binding WriteEpsilon}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding WriteEpsilon, StringFormat='0.00'}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Behaviors -->
      <Border Background="#141A22" CornerRadius="8" Padding="12" ToolTip.Tip="{x:Static core:HelpText.Behaviors}">
        <StackPanel Spacing="8">
          <TextBlock Text="Ambient behaviors" FontWeight="Bold" FontSize="15"/>
          <ItemsControl ItemsSource="{Binding BehaviorModules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BehaviorModuleViewModel">
                <Border Background="#0E141B" CornerRadius="6" Padding="10" Margin="0,4">
                  <Grid ColumnDefinitions="150,Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <CheckBox Grid.Row="0" Grid.Column="0" Content="{Binding Title}" IsChecked="{Binding Enabled}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="interval (s)" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MinIntervalS}" Minimum="0.2" Maximum="30" Increment="0.5" Width="110"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding MaxIntervalS}" Minimum="0.2" Maximum="30" Increment="0.5" Width="110" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="intensity" VerticalAlignment="Center"/>
                      <Slider Minimum="0" Maximum="1.5" Value="{Binding Intensity}" Width="120"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
